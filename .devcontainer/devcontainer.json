{
  "name": "Sophia multi-device cloud lab",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [8788, 8791],
  "portsAttributes": {
    "8788": { "label": "Device network coordinator", "onAutoForward": "notify" },
    "8791": { "label": "XYZ grid and codex API", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/startup.sh",
  "remoteUser": "root"
}
